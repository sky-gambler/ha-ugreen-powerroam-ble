      "user": {
        "title": "UGREEN PowerRoam",
        "description": "ポータブル電源を選択してください。先に UGREEN アプリを閉じてください。本体は同時に 1 つの Bluetooth 接続しか受け付けません。",
        "data": {
          "address": "デバイス"
        }
      },
      "bluetooth_confirm": {
        "description": "{name} を設定しますか？Home Assistant は状態を読み取り、出力、ライト、一部の設定を切り替えられます。Home Assistant が接続している間、UGREEN アプリは接続できません。"
      }
    },
    "abort": {
      "already_configured": "このポータブル電源はすでに設定されています。",
